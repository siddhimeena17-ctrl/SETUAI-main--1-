NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false until a qualified human reviewer has approved every Hindi field.
NEXT_PUBLIC_HINDI_CONTENT_REVIEWED=false

# Vercel AI Gateway
AI_GATEWAY_API_KEY=replace_with_vercel_ai_gateway_key
VERCEL_AI_GATEWAY_API_KEY=replace_with_vercel_ai_gateway_key
AI_GATEWAY_MODEL=amazon/nova-micro

# Optional standalone Sanity Studio. Public delivery stays disabled unless this
# explicit flag is set after a reviewed migration.
NEXT_PUBLIC_SANITY_PROJECT_ID=c243kj7a
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
SANITY_CONTENT_ENABLED=false

# Resend update emails
RESEND_API_KEY=replace_with_resend_api_key
UPDATES_FROM_EMAIL="SetuAI <updates@your-verified-domain.example>"
UPDATES_WEBHOOK_SECRET=choose_a_long_random_secret
INQUIRY_FROM_EMAIL="SetuAI inquiries <inquiries@your-verified-domain.example>"
INQUIRY_NOTIFY_TO=team@your-verified-domain.example

# Upstash CMS backend
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token

# Secure admin dashboard
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace_with_a_long_random_session_secret
# Generate with: openssl rand -base64 32
ADMIN_BOOTSTRAP_TOKEN=replace_with_a_private_first_admin_setup_token
# Optional comma-separated allowlist. If set, only these emails can create/sign in as admin.
ADMIN_ALLOWED_EMAILS=admin@example.com
